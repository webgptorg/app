# The stack's only resolver for test names (compose.yaml points the playwright, relay and mock engine containers here).
# Addresses are repeated from src/stack.ts; src/stack.test.ts fails if they drift apart.

# Our own domain: one A record per relay, the UI release store, and the dashboard (only the dashboard overlay runs it).
ptbk.test:53 {
    hosts {
        10.89.231.11 relay-a.ptbk.test
        10.89.231.12 relay-b.ptbk.test
        10.89.231.30 releases.ptbk.test
        10.89.231.60 app.ptbk.test
        ttl 5
    }
    errors
}

# The engine domain, and both relays in a fixed order under one name per relay that comes first, from zone files in
# zones/ (rendered by src/relay-dns/zones.ts; reload picks up a higher SOA serial). Every engine.test name, known
# engine or not, gets the relays, as production DNS would; the relays decide by SNI, so `unknown.engine.test` resolves
# and is then refused there. No AAAA records, so browsers never try another family. The failover tests map the engine
# hostname onto a `relay-<x>-first` name in a browser of their own, so the relay they take down is the one the browser
# tries first. The base stack serves coredns/zones/ (every relay, always); the nat scenario's relay-dns stand-in
# (compose.relay-dns.yaml) writes these zones instead and drops a relay that fails its health check (I-07).
order.ptbk.test:53 {
    file /etc/coredns/zones/order.ptbk.test.db {
        reload 1s
    }
    errors
}

engine.test:53 {
    file /etc/coredns/zones/engine.test.db {
        reload 1s
    }
    errors
}

# Anything else is refused: the stack is hermetic, so a browser test cannot quietly reach the internet.
.:53 {
    template ANY ANY {
        rcode REFUSED
    }
    errors
}
