# Build context is the repo root. Allowlist: only what the images need, so local secrets (.env, .dev.vars), build
# output and test results never reach an image.
*
!package.json
!bun.lock
!bunfig.toml
!tsconfig.base.json
!apps/*/package.json
!packages/*/package.json
!packages/protocol/
!packages/engine-api/
!packages/ui/
!packages/release-tools/
!apps/relay/
!apps/mock-engine/
!apps/engine-ui/
!e2e/
**/node_modules
**/dist
**/coverage
**/.env*
**/.dev.vars*
e2e/test-results
e2e/playwright-report
# engine-ui build output and generated code: the ui-bundle stage builds its own.
apps/engine-ui/release
apps/engine-ui/reports
apps/engine-ui/test-results
apps/engine-ui/playwright-report
apps/engine-ui/src/paraglide
**/routeTree.gen.ts
