{
  "name": "@ptbk/engine-ui",
  "version": "0.2.3",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Private engine UI: static bundle the engine downloads, verifies and serves",
  "scripts": {
    "generate": "paraglide-js compile --project ./project.inlang && tsr generate",
    "dev": "vite dev --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -b",
    "test": "bun run build && vitest run --coverage",
    "test:csp": "VITE_UI_GALLERY=1 bun run build && playwright test",
    "pack": "tsx scripts/pack.ts",
    "verify-reproducible": "tsx scripts/verify-reproducible.ts",
    "release:tag": "tsx scripts/release-tag.ts",
    "release:attest": "tsx scripts/attest.ts",
    "release:sign": "tsx scripts/sign-release.ts",
    "release:verify": "tsx scripts/release-verify.ts",
    "release:publish": "tsx scripts/publish.ts",
    "release:keygen": "tsx scripts/keygen.ts",
    "release:revocations": "tsx scripts/revocations.ts",
    "release:refresh-trusted-root": "tsx scripts/refresh-trusted-root.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/common": "1.5.3",
    "@lezer/css": "1.3.9",
    "@lezer/highlight": "1.2.5",
    "@lezer/html": "1.3.13",
    "@lezer/javascript": "1.5.6",
    "@lezer/json": "1.0.3",
    "@lezer/markdown": "1.8.1",
    "@lezer/python": "1.1.19",
    "@lezer/yaml": "1.0.4",
    "@ptbk/engine-api": "workspace:*",
    "@ptbk/protocol": "workspace:*",
    "@ptbk/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "lucide-react": "catalog:",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "catalog:",
