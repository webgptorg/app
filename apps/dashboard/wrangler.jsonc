// Top level is local development only. Staging and production values are placeholders that I-02 fills in.
// The compatibility date stays within what the workerd bundled with @cloudflare/vitest-pool-workers supports, so the
// Workers tests run the same date as production.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ptbk-dashboard",
    "main": "src/worker.ts",
    "compatibility_date": "2026-08-15",
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // The Worker sets the security headers on the HTML shell, so only Vite's fingerprinted files bypass it.
        "run_worker_first": ["/*", "!/assets/*"],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "ptbk-dashboard-dev",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations",
        },
    ],
    "vars": {
        "ENVIRONMENT": "dev",
        "DASHBOARD_ORIGIN": "http://localhost:5173",
        "ENGINE_DOMAIN": "engines.ptbk.test",
        "RELAYS": [{ "relayId": "relay.ptbk.test", "region": "local" }],
        // Shown on /engines/new with the link code; X-06's `dev:link` starts the local mock engine with it.
        "INSTALL_COMMAND": "bun run dev:link {linkCode}",
        "ADAPTERS": { "email": "fake", "billing": "fake", "rateLimit": "memory" },
        "EMAIL_FROM": "no-reply@ptbk.test",
        // Optional everywhere; these are the defaults. An engine is offline after missedLimit × intervalS + graceS
        // seconds without an accepted heartbeat; perEngineLimit is heartbeats per engine and minute. The e2e stack
        // sends every 15 s and sets intervalS to match.
        "HEARTBEAT": { "intervalS": 60, "missedLimit": 3, "graceS": 15, "perEngineLimit": 5 },
        // Dev only; config refuses it elsewhere. Staging and production: `wrangler secret put RATE_LIMIT_HMAC_KEY`.
        "RATE_LIMIT_HMAC_KEY": "ZGV2LW9ubHktcmF0ZS1saW1pdC1rZXktbm90LXNlY3JldA",
        // Placeholder plans until pricing is decided (ADR 0017). `none` follows the spec's "card on file before an
        // engine": no subscription, no engine. Stripe secrets (`wrangler secret put STRIPE_SECRET_KEY`,
        // `STRIPE_WEBHOOK_SECRET`) are needed only with the stripe billing adapter.
        "BILLING_PLANS": {
            "none": { "features": [], "quotas": { "engines.max": 0, "custom-domains.max": 0 } },
            "plans": [
                {
                    "id": "standard",
                    "stripeProductId": "prod_devstandard",
                    "stripePriceId": "price_devstandard",
                    "features": ["engines.create"],
                    "quotas": { "engines.max": null, "custom-domains.max": 0 },
                },
            ],
        },
    },
    // Hourly rate limits (D-02): the Workers Rate Limiting binding only has 10 s and 60 s periods. One EngineStatus
    // per engine (D-05): heartbeats, offline detection and alerts. Its storage is the object's own, not D1's.
    "durable_objects": {
        "bindings": [
            { "name": "HOURLY_RATE_LIMITER", "class_name": "HourlyRateLimiter" },
            { "name": "ENGINE_STATUS", "class_name": "EngineStatus" },
        ],
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["HourlyRateLimiter"] },
        { "tag": "v2", "new_sqlite_classes": ["EngineStatus"] },
    ],
    // Per-minute rate limits; limit and period must match RATE_LIMITS in src/domain/ports/rate-limiter.ts.
    "ratelimits": [
        { "name": "RATE_LIMIT_OPTIONS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RATE_LIMIT_VERIFY", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
        { "name": "RATE_LIMIT_PUBLIC_READ", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
        { "name": "RATE_LIMIT_WEBHOOK", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } },
        { "name": "RATE_LIMIT_REGISTRY", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } },
        { "name": "RATE_LIMIT_HEARTBEAT", "namespace_id": "1006", "simple": { "limit": 600, "period": 60 } },
    ],
    "env": {
        "staging": {
            "routes": [{ "pattern": "app.staging.<placeholder>", "custom_domain": true }],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "ptbk-dashboard-staging",
                    "database_id": "<staging-d1-id>",
                    "migrations_dir": "migrations",
                },
            ],
            "vars": {
                "ENVIRONMENT": "staging",
                "DASHBOARD_ORIGIN": "https://app.staging.<placeholder>",
                "ENGINE_DOMAIN": "<staging-engine-domain>",
                "RELAYS": [{ "relayId": "relay-1.staging.<placeholder>", "region": "eu-central" }],
                // Placeholder until the engine team defines the install command (E-01).
                "INSTALL_COMMAND": "<engine-install-command> {linkCode}",
                "ADAPTERS": { "email": "cloudflare", "billing": "stripe", "rateLimit": "workers" },
                "EMAIL_FROM": "no-reply@<staging-sending-domain>",
                // Test-mode Stripe IDs; secrets via `wrangler secret put STRIPE_SECRET_KEY --env staging` (and
                // STRIPE_WEBHOOK_SECRET). Quotas are placeholders until pricing is decided.
                "BILLING_PLANS": {
                    "none": { "features": [], "quotas": { "engines.max": 0, "custom-domains.max": 0 } },
                    "plans": [
                        {
                            "id": "standard",
                            "stripeProductId": "<staging-standard-product-id>",
                            "stripePriceId": "<staging-standard-price-id>",
                            "features": ["engines.create"],
                            "quotas": { "engines.max": null, "custom-domains.max": 0 },
                        },
                    ],
                },
            },
            "send_email": [{ "name": "EMAIL" }],
            "durable_objects": {
                "bindings": [
                    { "name": "HOURLY_RATE_LIMITER", "class_name": "HourlyRateLimiter" },
                    { "name": "ENGINE_STATUS", "class_name": "EngineStatus" },
                ],
            },
            "migrations": [
                { "tag": "v1", "new_sqlite_classes": ["HourlyRateLimiter"] },
                { "tag": "v2", "new_sqlite_classes": ["EngineStatus"] },
            ],
            "ratelimits": [
                { "name": "RATE_LIMIT_OPTIONS", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
                { "name": "RATE_LIMIT_VERIFY", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
                {
                    "name": "RATE_LIMIT_PUBLIC_READ",
                    "namespace_id": "2003",
                    "simple": { "limit": 120, "period": 60 },
                },
                { "name": "RATE_LIMIT_WEBHOOK", "namespace_id": "2004", "simple": { "limit": 600, "period": 60 } },
                { "name": "RATE_LIMIT_REGISTRY", "namespace_id": "2005", "simple": { "limit": 600, "period": 60 } },
                {
                    "name": "RATE_LIMIT_HEARTBEAT",
                    "namespace_id": "2006",
                    "simple": { "limit": 600, "period": 60 },
                },
            ],
        },
        "production": {
            "routes": [{ "pattern": "app.ptbk.io", "custom_domain": true }],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "ptbk-dashboard-production",
                    "database_id": "<production-d1-id>",
                    "migrations_dir": "migrations",
                },
            ],
            "vars": {
                "ENVIRONMENT": "production",
                "DASHBOARD_ORIGIN": "https://app.ptbk.io",
                "ENGINE_DOMAIN": "<engine-domain>",
                "RELAYS": [{ "relayId": "relay-1.<engine-domain>", "region": "eu-central" }],
                // Placeholder until the engine team defines the install command (E-01).
                "INSTALL_COMMAND": "<engine-install-command> {linkCode}",
                "ADAPTERS": { "email": "cloudflare", "billing": "stripe", "rateLimit": "workers" },
                "EMAIL_FROM": "no-reply@<production-sending-domain>",
                // Live-mode Stripe IDs; secrets via `wrangler secret put STRIPE_SECRET_KEY --env production` (and
                // STRIPE_WEBHOOK_SECRET). Quotas are placeholders until pricing is decided.
                "BILLING_PLANS": {
                    "none": { "features": [], "quotas": { "engines.max": 0, "custom-domains.max": 0 } },
                    "plans": [
                        {
                            "id": "standard",
                            "stripeProductId": "<production-standard-product-id>",
                            "stripePriceId": "<production-standard-price-id>",
                            "features": ["engines.create"],
                            "quotas": { "engines.max": null, "custom-domains.max": 0 },
                        },
                    ],
                },
            },
            "send_email": [{ "name": "EMAIL" }],
            "durable_objects": {
                "bindings": [
                    { "name": "HOURLY_RATE_LIMITER", "class_name": "HourlyRateLimiter" },
                    { "name": "ENGINE_STATUS", "class_name": "EngineStatus" },
                ],
            },
            "migrations": [
                { "tag": "v1", "new_sqlite_classes": ["HourlyRateLimiter"] },
                { "tag": "v2", "new_sqlite_classes": ["EngineStatus"] },
            ],
            "ratelimits": [
                { "name": "RATE_LIMIT_OPTIONS", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } },
                { "name": "RATE_LIMIT_VERIFY", "namespace_id": "3002", "simple": { "limit": 30, "period": 60 } },
                {
                    "name": "RATE_LIMIT_PUBLIC_READ",
                    "namespace_id": "3003",
                    "simple": { "limit": 120, "period": 60 },
                },
                { "name": "RATE_LIMIT_WEBHOOK", "namespace_id": "3004", "simple": { "limit": 600, "period": 60 } },
                { "name": "RATE_LIMIT_REGISTRY", "namespace_id": "3005", "simple": { "limit": 600, "period": 60 } },
                {
                    "name": "RATE_LIMIT_HEARTBEAT",
                    "namespace_id": "3006",
                    "simple": { "limit": 600, "period": 60 },
                },
            ],
        },
    },
}
