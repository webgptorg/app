// Top level is local development only. Staging and production values are placeholders that I-02 fills in.
// The compatibility date stays within what the workerd bundled with @cloudflare/vitest-pool-workers supports, so the
// Workers tests run the same date as production.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ptbk-dashboard",
    "main": "src/worker.ts",
    "compatibility_date": "2026-08-15",
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // The Worker sets the security headers on the HTML shell, so only Vite's fingerprinted files bypass it.
        "run_worker_first": ["/*", "!/assets/*"],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "ptbk-dashboard-dev",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations",
        },
    ],
    "vars": {
        "ENVIRONMENT": "dev",
        "DASHBOARD_ORIGIN": "http://localhost:5173",
        "ENGINE_DOMAIN": "engines.ptbk.test",
        "RELAYS": [{ "relayId": "relay.ptbk.test", "region": "local" }],
        // The tabs of /engines/new, each with {linkCode} or {linkUrl} once; {linkUrl} needs an https origin, so dev's
        // plain-http default keeps the code. X-06's `dev:link` starts the local mock engine; the last tab runs M-08's
        // `connect` in the stack's engine container; Compose is installation.md's three commands.
        "INSTALL_COMMANDS": [
            {
                "id": "installer",
                "labelKey": "docker-server",
                "template": "bun run dev:link {linkCode}",
                "docsAnchor": "1-the-installer-recommended",
            },
            {
                "id": "compose",
                "labelKey": "docker-compose",
                "template": "docker compose run --rm engine promptbook-engine connect --link {linkCode}\ndocker compose up -d\ndocker compose exec engine promptbook-engine setup-link",
                "docsAnchor": "2-docker-compose",
            },
            {
                "id": "connect",
                "labelKey": "already-running",
                "template": "docker compose -p ptbk-dev exec mock-engine node /app/main.mjs connect --link {linkCode}",
                "docsAnchor": "3-link-an-engine-that-already-runs",
            },
        ],
        // Where each tab's "Requirements and proxies" link points, with the tab's docsAnchor.
        "INSTALL_GUIDE_URL": "https://github.com/webgptorg/app/blob/main/docs/engine-integration/installation.md",
        "ADAPTERS": { "email": "fake", "billing": "fake", "rateLimit": "memory" },
        "EMAIL_FROM": "no-reply@ptbk.test",
        // The public abuse contact (I-05): /abuse, security.txt, suspended engines' pages, and abuse alerts.
        "ABUSE_EMAIL": "abuse@ptbk.test",
        // Optional everywhere; these are the defaults. An engine is offline after missedLimit × intervalS + graceS
        // seconds without an accepted heartbeat; perEngineLimit is heartbeats per engine and minute. The e2e stack
        // sends every 15 s and sets intervalS to match.
        "HEARTBEAT": { "intervalS": 60, "missedLimit": 3, "graceS": 15, "perEngineLimit": 5 },
        // Dev only; config refuses it elsewhere. Staging and production: `wrangler secret put RATE_LIMIT_HMAC_KEY`.
        "RATE_LIMIT_HMAC_KEY": "ZGV2LW9ubHktcmF0ZS1saW1pdC1rZXktbm90LXNlY3JldA",
        // Dev only; config refuses it elsewhere. Staging and production: `wrangler secret put MEMBER_KEY` (32 random
        // bytes, base64url); without it the dashboard issues no access tickets and holds revocations back.
        "MEMBER_KEY": "ZGV2LW9ubHktbWVtYmVyLWtleS1ub3QtYS1zZWNyZXQ",
        // Placeholder plans until pricing is decided (ADR 0017). `none` follows the spec's "card on file before an
        // engine": no subscription, no engine. Stripe secrets (`wrangler secret put STRIPE_SECRET_KEY`,
        // `STRIPE_WEBHOOK_SECRET`) are needed only with the stripe billing adapter.
        "BILLING_PLANS": {
            "none": { "features": [], "quotas": { "engines.max": 0, "custom-domains.max": 0 } },
            "plans": [
                {
                    "id": "standard",
                    "name": { "en": "Standard", "cs": "Standard" },
                    "stripeProductId": "prod_devstandard",
                    "stripePriceId": "price_devstandard",
                    "features": ["engines.create"],
                    "quotas": { "engines.max": null, "custom-domains.max": 0 },
                    // The fake Checkout grants it as Stripe would (D-10); staging and production set theirs with pricing.
                    "trialDays": 14,
                },
            ],
        },
    },
    // Hourly rate limits (D-02): the Workers Rate Limiting binding only has 10 s and 60 s periods. One EngineStatus
    // per engine (D-05): heartbeats, offline detection and alerts. Its storage is the object's own, not D1's. One
    // WebRiskLists (I-08): Google Web Risk's threat lists, megabytes of hash prefixes, for the abuse feed.
    "durable_objects": {
        "bindings": [
            { "name": "HOURLY_RATE_LIMITER", "class_name": "HourlyRateLimiter" },
            { "name": "ENGINE_STATUS", "class_name": "EngineStatus" },
            { "name": "OPS_MONITOR", "class_name": "OpsMonitor" },
            { "name": "WEB_RISK_LISTS", "class_name": "WebRiskLists" },
        ],
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["HourlyRateLimiter"] },
        { "tag": "v2", "new_sqlite_classes": ["EngineStatus"] },
        { "tag": "v3", "new_sqlite_classes": ["OpsMonitor"] },
        { "tag": "v4", "new_sqlite_classes": ["WebRiskLists"] },
    ],
    // The relay monitor every minute (I-04), the abuse jobs every 15 minutes (I-05); src/app/scheduled-jobs.ts lists the
    // jobs, and a test keeps the two in step. Locally nothing fires on its own: the e2e monitoring overlay triggers it.
    "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
    // Monitoring data (I-04, ADR 0012): aggregates only, no engine, hostname, address or account.
    "analytics_engine_datasets": [{ "binding": "OPS_METRICS", "dataset": "ptbk_ops_dev" }],
    // Per-minute rate limits; limit and period must match RATE_LIMITS in src/domain/ports/rate-limiter.ts.
    "ratelimits": [
        { "name": "RATE_LIMIT_OPTIONS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RATE_LIMIT_VERIFY", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
        { "name": "RATE_LIMIT_PUBLIC_READ", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
        { "name": "RATE_LIMIT_WEBHOOK", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } },
        { "name": "RATE_LIMIT_REGISTRY", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } },
        { "name": "RATE_LIMIT_HEARTBEAT", "namespace_id": "1006", "simple": { "limit": 600, "period": 60 } },
        { "name": "RATE_LIMIT_PRESENCE", "namespace_id": "1007", "simple": { "limit": 30, "period": 60 } },
    ],
    "env": {
        "staging": {
            // app.ptbk.io's zone is in another account, so the Worker serves it as a Cloudflare for SaaS custom hostname
            // of ptbk.link (infra/cloudflare README, Dashboard on another account's zone), not as a custom domain.
            "routes": [{ "pattern": "app.ptbk.io/*", "zone_name": "ptbk.link" }],
            "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
            "analytics_engine_datasets": [{ "binding": "OPS_METRICS", "dataset": "ptbk_ops_staging" }],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "ptbk-dashboard-staging",
                    "database_id": "663996ef-d6cd-4769-b7ff-2584301247ae",
                    "migrations_dir": "migrations",
                },
            ],
            "vars": {
                "ENVIRONMENT": "staging",
                "DASHBOARD_ORIGIN": "https://app.ptbk.io",
                "ENGINE_DOMAIN": "engines.ptbk.link",
                "RELAYS": [{ "relayId": "relay-fsn.ptbk.link", "region": "eu-central" }],
                // Reborn's `ptbk` CLI. The link URL names this dashboard, so the engine needs no PTBK_DASHBOARD_URL and
                // keeps the origin with its registration; single quotes, because zsh may glob the `#`. One logical line,
                // so an interactive `ptbk init` cannot swallow the rest of a paste. `--path .`: in an empty folder init
                // otherwise offers the shared projects folder first, where `connect`, run here, would find no project.
                "INSTALL_COMMANDS": [
                    {
                        "id": "installer",
                        "labelKey": "new-project",
                        "template": "npm install --global ptbk \\\n  && mkdir -p my-agenda && cd my-agenda \\\n  && ptbk init --path . --no-dashboard \\\n  && ptbk connect --link '{linkUrl}'",
                        "docsAnchor": "networking",
                    },
                    {
                        "id": "connect",
                        "labelKey": "already-running",
                        "template": "ptbk stop \\\n  && ptbk connect --link '{linkUrl}' \\\n  && ptbk start --no-dashboard",
                        "docsAnchor": "networking",
                    },
                ],
                "INSTALL_GUIDE_URL": "https://github.com/webgptorg/promptbook/blob/reborn/2026-10/specs/app/connection.md",
                "ADAPTERS": { "email": "cloudflare", "billing": "off", "rateLimit": "workers" },
                "EMAIL_FROM": "no-reply@mail.ptbk.link",
                "ABUSE_EMAIL": "abuse@ptbk.link",
                // I-04: alerts go to the ops mailbox; relay metrics tokens are the RELAY_METRICS_TOKENS secret and
                // the analytics read token ANALYTICS_API_TOKEN (docs/runbooks/observability.md).
                "MONITORING": { "opsEmail": "ops@ptbk.link" },
                "ANALYTICS": { "accountId": "42b20127fa7293cb5160f22ed42ef43b", "dataset": "ptbk_ops_staging" },
                // Staging charges nobody (Seb, 2026-11-04): billing is "off" and every organization holds BILLING_OFF_PLAN,
                // without Stripe secrets or IDs; its quotas are config, so changing them needs no code. To charge here
                // too, in one change: set ADAPTERS.billing to "stripe", replace BILLING_OFF_PLAN with the BILLING_PLANS
                // below, and put both Stripe secrets (ADR 0017, deploy.md). Production always charges.
                "BILLING_OFF_PLAN": {
                    "features": ["engines.create"],
                    "quotas": { "engines.max": 10, "custom-domains.max": 0 },
                },
                // Test-mode Stripe IDs; secrets via `wrangler secret put STRIPE_SECRET_KEY --env staging` (and
                // STRIPE_WEBHOOK_SECRET). Quotas are placeholders until pricing is decided.
                // "BILLING_PLANS": {
                //     "none": { "features": [], "quotas": { "engines.max": 0, "custom-domains.max": 0 } },
                //     "plans": [
                //         {
                //             "id": "standard",
                //             "name": { "en": "Standard", "cs": "Standard" },
                //             "stripeProductId": "<staging-standard-product-id>",
                //             "stripePriceId": "<staging-standard-price-id>",
                //             "features": ["engines.create"],
                //             "quotas": { "engines.max": null, "custom-domains.max": 0 },
                //         },
                //     ],
                // },
            },
            "send_email": [{ "name": "EMAIL" }],
            "durable_objects": {
                "bindings": [
                    { "name": "HOURLY_RATE_LIMITER", "class_name": "HourlyRateLimiter" },
                    { "name": "ENGINE_STATUS", "class_name": "EngineStatus" },
                    { "name": "OPS_MONITOR", "class_name": "OpsMonitor" },
                    { "name": "WEB_RISK_LISTS", "class_name": "WebRiskLists" },
                ],
            },
            "migrations": [
                { "tag": "v1", "new_sqlite_classes": ["HourlyRateLimiter"] },
                { "tag": "v2", "new_sqlite_classes": ["EngineStatus"] },
                { "tag": "v3", "new_sqlite_classes": ["OpsMonitor"] },
                { "tag": "v4", "new_sqlite_classes": ["WebRiskLists"] },
            ],
            "ratelimits": [
                { "name": "RATE_LIMIT_OPTIONS", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
                { "name": "RATE_LIMIT_VERIFY", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
                {
                    "name": "RATE_LIMIT_PUBLIC_READ",
                    "namespace_id": "2003",
                    "simple": { "limit": 120, "period": 60 },
                },
                { "name": "RATE_LIMIT_WEBHOOK", "namespace_id": "2004", "simple": { "limit": 600, "period": 60 } },
                { "name": "RATE_LIMIT_REGISTRY", "namespace_id": "2005", "simple": { "limit": 600, "period": 60 } },
                {
                    "name": "RATE_LIMIT_HEARTBEAT",
                    "namespace_id": "2006",
                    "simple": { "limit": 600, "period": 60 },
                },
                { "name": "RATE_LIMIT_PRESENCE", "namespace_id": "2007", "simple": { "limit": 30, "period": 60 } },
            ],
        },
        "production": {
            "routes": [{ "pattern": "app.ptbk.io", "custom_domain": true }],
            "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
            "analytics_engine_datasets": [{ "binding": "OPS_METRICS", "dataset": "ptbk_ops_production" }],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "ptbk-dashboard-production",
                    "database_id": "<production-d1-id>",
                    "migrations_dir": "migrations",
                },
            ],
            "vars": {
                "ENVIRONMENT": "production",
                "DASHBOARD_ORIGIN": "https://app.ptbk.io",
                "ENGINE_DOMAIN": "<engine-domain>",
                "RELAYS": [{ "relayId": "relay-1.<engine-domain>", "region": "eu-central" }],
                // Placeholders until the engine team publishes the installer, its hash and the image (apply.md).
                "INSTALL_COMMANDS": [
                    {
                        "id": "installer",
                        "labelKey": "docker-server",
                        "template": "curl -fsSLo promptbook-install.sh <installer-url> \\\n  && echo \"<installer-sha256>  promptbook-install.sh\" | sha256sum -c - \\\n  && sudo sh promptbook-install.sh --link '{linkUrl}'",
                        "docsAnchor": "1-the-installer-recommended",
                    },
                    {
                        "id": "compose",
                        "labelKey": "docker-compose",
                        "template": "docker compose run --rm engine promptbook-engine connect --link '{linkUrl}'\ndocker compose up -d\ndocker compose exec engine promptbook-engine setup-link",
                        "docsAnchor": "2-docker-compose",
                    },
                    {
                        "id": "connect",
                        "labelKey": "already-running",
                        "template": "promptbook-engine connect --link '{linkUrl}'",
                        "docsAnchor": "3-link-an-engine-that-already-runs",
                    },
                ],
                "INSTALL_GUIDE_URL": "<public-install-guide-url>",
                "ADAPTERS": { "email": "cloudflare", "billing": "stripe", "rateLimit": "workers" },
                "EMAIL_FROM": "no-reply@<production-sending-domain>",
                "ABUSE_EMAIL": "abuse@<production-abuse-domain>",
                "MONITORING": { "opsEmail": "ops@<production-ops-domain>" },
                "ANALYTICS": { "accountId": "<production-account-id>", "dataset": "ptbk_ops_production" },
                // Live-mode Stripe IDs; secrets via `wrangler secret put STRIPE_SECRET_KEY --env production` (and
                // STRIPE_WEBHOOK_SECRET). Quotas are placeholders until pricing is decided.
                "BILLING_PLANS": {
                    "none": { "features": [], "quotas": { "engines.max": 0, "custom-domains.max": 0 } },
                    "plans": [
                        {
                            "id": "standard",
                            "name": { "en": "Standard", "cs": "Standard" },
                            "stripeProductId": "<production-standard-product-id>",
                            "stripePriceId": "<production-standard-price-id>",
                            "features": ["engines.create"],
                            "quotas": { "engines.max": null, "custom-domains.max": 0 },
                        },
                    ],
                },
            },
            "send_email": [{ "name": "EMAIL" }],
            "durable_objects": {
                "bindings": [
                    { "name": "HOURLY_RATE_LIMITER", "class_name": "HourlyRateLimiter" },
                    { "name": "ENGINE_STATUS", "class_name": "EngineStatus" },
                    { "name": "OPS_MONITOR", "class_name": "OpsMonitor" },
                    { "name": "WEB_RISK_LISTS", "class_name": "WebRiskLists" },
                ],
            },
            "migrations": [
                { "tag": "v1", "new_sqlite_classes": ["HourlyRateLimiter"] },
                { "tag": "v2", "new_sqlite_classes": ["EngineStatus"] },
                { "tag": "v3", "new_sqlite_classes": ["OpsMonitor"] },
                { "tag": "v4", "new_sqlite_classes": ["WebRiskLists"] },
            ],
            "ratelimits": [
                { "name": "RATE_LIMIT_OPTIONS", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } },
                { "name": "RATE_LIMIT_VERIFY", "namespace_id": "3002", "simple": { "limit": 30, "period": 60 } },
                {
                    "name": "RATE_LIMIT_PUBLIC_READ",
                    "namespace_id": "3003",
                    "simple": { "limit": 120, "period": 60 },
                },
                { "name": "RATE_LIMIT_WEBHOOK", "namespace_id": "3004", "simple": { "limit": 600, "period": 60 } },
                { "name": "RATE_LIMIT_REGISTRY", "namespace_id": "3005", "simple": { "limit": 600, "period": 60 } },
                {
                    "name": "RATE_LIMIT_HEARTBEAT",
                    "namespace_id": "3006",
                    "simple": { "limit": 600, "period": 60 },
                },
                { "name": "RATE_LIMIT_PRESENCE", "namespace_id": "3007", "simple": { "limit": 30, "period": 60 } },
            ],
        },
    },
}
