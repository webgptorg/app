{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/worker.tsbuildinfo",
    "lib": ["ES2024"],
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/workerd-webcrypto.d.ts",
    "src/worker.ts",
    "src/worker-env.d.ts",
    "src/app/**/*",
    "src/domain/**/*",
    "src/adapters/**/*",
    "src/shared/**/*",
    "src/testing/**/*",
    "src/paraglide/**/*.d.ts",
    "test/http/**/*"
  ]
}
