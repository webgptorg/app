{
  "name": "@ptbk/dashboard",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "app.ptbk.io: entry point, engine list, registry API, heartbeat ingest (Cloudflare Workers)",
  "scripts": {
    "generate": "paraglide-js compile --project ./project.inlang && tsr generate && wrangler types",
    "dev": "bun run db:migrate:local && vite dev",
    "dev:https": "bun run db:migrate:local && vite dev --mode https",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "bun run db:check && bun run build && vitest run --coverage --project unit --project client && vitest run --project workers && node scripts/check-bundle-budgets.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:check": "node scripts/check-migrations.ts",
    "test:csp": "bun run build && playwright test"
  },
  "dependencies": {
    "@ptbk/protocol": "workspace:*",
    "@ptbk/ui": "workspace:*",
    "@simplewebauthn/browser": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "drizzle-orm": "0.45.4",
    "hono": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "catalog:",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "wrangler": "4.158.0"
  }
}
