# The relay under load: production defaults except what the test topology needs. Every generator connection comes
# from one IP, so the per-IP limits are raised out of the way (docs/perf/relay-load-test.md says so for each number).
# run.ts layers a per-case file on top of this one.
RELAY_HOSTNAME=relay.load.test
RELAY_LISTEN_PORT=443
RELAY_ENGINE_DOMAIN=engine.load.test
RELAY_TLS_CERT_FILE=/pki/relay-cert.pem
RELAY_TLS_KEY_FILE=/relay-key/key.pem
RELAY_REGISTRY_KIND=static
RELAY_REGISTRY_FILE=/pki/registry.json
RELAY_MAX_PENDING_HANDSHAKES_PER_IP=1000
RELAY_MAX_TUNNELS_PER_IP=1000000
RELAY_MAX_CONNECTIONS_PER_IP=1000000
RELAY_NEW_CONNECTIONS_PER_IP_PER_S=1000000
