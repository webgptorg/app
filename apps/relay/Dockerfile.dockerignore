# The relay image needs the workspace manifests, the lockfile and the relay's and protocol's sources only.
**
!package.json
!bun.lock
!bunfig.toml
!tsconfig.base.json
!apps/*/package.json
!packages/*/package.json
!e2e/package.json
!apps/relay/tsconfig.json
!apps/relay/tsdown.config.ts
!apps/relay/src/**
!packages/protocol/src/**
**/*.test.ts
**/node_modules
