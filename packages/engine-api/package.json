{
  "name": "@ptbk/engine-api",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Engine HTTP API contract consumed by engine-ui (MIT; moves to the public repo, ADR 0002)",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p scripts",
    "test": "vitest run --passWithNoTests",
    "openapi": "node --import ./scripts/resolve-ts.ts scripts/write-openapi.ts && prettier --write openapi.json"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0"
  }
}
