{
  "name": "@ptbk/conformance",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Conformance suite any engine must pass to replace the mock engine (MIT; moves to the public repo, ADR 0002)",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "ptbk-conformance": "./dist/ptbk-conformance.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "bun build bin/ptbk-conformance.ts --target=node --outfile dist/ptbk-conformance.js",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p bin",
    "test": "bun run build && vitest run --coverage"
  },
  "dependencies": {
    "@ptbk/engine-api": "workspace:*",
    "@ptbk/protocol": "workspace:*"
  }
}
