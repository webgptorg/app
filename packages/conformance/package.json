{
  "name": "@ptbk/conformance",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Conformance suite any engine must pass to replace the mock engine (MIT; moves to the public repo, ADR 0002)",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./node/index.ts"
  },
  "bin": {
    "ptbk-conformance": "./dist/ptbk-conformance.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "bun build bin/ptbk-conformance.ts --target=node --outfile dist/ptbk-conformance.js",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p node && tsc --noEmit -p bin",
    "test": "bun run build && bun run --filter @ptbk/mock-engine build && vitest run --coverage"
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@ptbk/engine-api": "workspace:*",
    "@ptbk/protocol": "workspace:*",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@sigstore/bundle": "catalog:",
    "@sigstore/protobuf-specs": "catalog:",
    "@sigstore/verify": "catalog:",
    "@types/ws": "catalog:"
  }
}
