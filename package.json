{
  "name": "promptbook-platform",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@inlang/paraglide-js": "2.27.0",
      "@inlang/plugin-message-format": "4.5.0",
      "@noble/curves": "2.4.0",
      "@peculiar/asn1-schema": "2.10.0",
      "@peculiar/asn1-x509": "2.10.0",
      "@peculiar/x509": "2.1.0",
      "@sigstore/bundle": "5.0.0",
      "@sigstore/protobuf-specs": "0.5.2",
      "@sigstore/verify": "4.1.2",
      "@simplewebauthn/browser": "14.0.0",
      "@simplewebauthn/server": "14.0.3",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/react-query": "5.104.2",
      "@tanstack/react-router": "1.170.42",
      "@tanstack/router-cli": "1.167.41",
      "@tanstack/router-plugin": "1.168.43",
      "@testing-library/dom": "10.4.2",
      "@testing-library/react": "16.3.3",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "eslint": "10.12.0",
      "hono": "4.13.13",
      "jsdom": "30.1.2",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "sigstore": "5.0.0",
      "stripe": "22.6.2",
      "tailwindcss": "4.3.3",
      "vite": "8.3.4",
      "ws": "8.22.0",
      "zod": "4.6.6"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run generate && bun run lint && bun run format:check && bun run typecheck && bun run test && bun run plan --check",
    "prepare": "husky",
    "plan": "node scripts/plan.ts",
    "generate": "bun run --filter '*' --if-present generate"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
