# What ptbk-relay-deploy accepts (I-03). Changing a value changes what can run on this relay: review it like code.
PTBK_DEPLOY_IMAGE_REPOSITORY=ghcr.io/webgptorg/relay
# The exact signer (ADR 0014): release-relay.yml on main in this repository, through GitHub's OIDC issuer.
PTBK_DEPLOY_CERT_IDENTITY=https://github.com/webgptorg/app/.github/workflows/release-relay.yml@refs/heads/main
PTBK_DEPLOY_CERT_OIDC_ISSUER=https://token.actions.githubusercontent.com
PTBK_DEPLOY_CERT_REPOSITORY=webgptorg/app
# Empty: Sigstore's public-good trusted root through cosign's TUF client. Only the deploy test pins its own.
PTBK_DEPLOY_TRUSTED_ROOT=
# How long a new image has to answer /healthz and win back its engines before it is rolled back (engines reconnect
# within 10 s), and which share of the engines connected before the swap counts as recovered.
PTBK_DEPLOY_TIMEOUT_S=60
PTBK_DEPLOY_TUNNEL_RECOVERY_PERCENT=90
# An image built more than this many days before the newest one this host ever ran is refused (a rollback to the
# previous image and digests listed in /etc/ptbk-relay/allow-downgrade excepted), so moving a tag cannot bring back an
# old release.
PTBK_DEPLOY_MAX_DOWNGRADE_DAYS=30
# The guard counts from the newest image this host ever ran, which a fresh or rebuilt host does not know yet: this
# floor (a UTC date, e.g. 2026-10-01, empty for none) refuses anything built before it from the first deploy on. Raise
# it to a recent release's build date when rebuilding hosts.
PTBK_DEPLOY_MIN_CREATED=
