# The relay's environment (apps/relay/README.md). Secrets are not here: they arrive as credential files.
RELAY_HOSTNAME=${relay_hostname}
RELAY_ENGINE_DOMAIN=${engine_domain}
# One dual-stack socket for IPv4 and IPv6 (net.ipv6.bindv6only = 0); the relay maps ::ffff:a.b.c.d back to IPv4.
RELAY_LISTEN_HOST=::
RELAY_LISTEN_PORT=443
RELAY_TLS_CERT_FILE=/run/credentials/relay/tls.crt
RELAY_TLS_KEY_FILE=/run/credentials/relay/tls.key
RELAY_REGISTRY_KIND=http
RELAY_REGISTRY_URL=${registry_url}
RELAY_REGISTRY_TOKEN_FILE=/run/credentials/relay/registry-token
# GET /metrics on the relay hostname answers only this token (I-04): the dashboard's scrape.
RELAY_METRICS_TOKEN_FILE=/run/credentials/relay/metrics-token
RELAY_DNS_SERVERS=127.0.0.1
RELAY_MAX_CONNECTIONS=${max_connections}
RELAY_MEMORY_BUDGET_BYTES=${memory_budget_bytes}
%{ for name, value in settings ~}
${name}=${value}
%{ endfor ~}
