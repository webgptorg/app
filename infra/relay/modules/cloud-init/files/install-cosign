#!/bin/bash
# Installs the cosign the deploy script verifies images with (I-03), at first boot. Debian 13's cosign (2.5) predates
# the bundle format and Rekor v2 entries cosign 3 signs with, so the hosts run the same release as release-relay.yml,
# pinned by SHA-256 here. Upgrading means a new version and both hashes from its cosign_checksums.txt, then rebuilt
# hosts.
set -euo pipefail

readonly VERSION=v3.1.3
declare -A SHA256=(
    [amd64]=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
    [arm64]=c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a
)

arch=$(dpkg --print-architecture)
[[ -n ${SHA256[$arch]:-} ]] || {
    echo "install-cosign: no pinned cosign for $arch" >&2
    exit 1
}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
curl -fsSL --proto '=https' --tlsv1.2 --retry 3 -o "$work/cosign" \
    "https://github.com/sigstore/cosign/releases/download/$VERSION/cosign-linux-$arch"
echo "${SHA256[$arch]}  $work/cosign" | sha256sum --check --quiet -
install -m 0755 -o root -g root "$work/cosign" /usr/local/bin/cosign
