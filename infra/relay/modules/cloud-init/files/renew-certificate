#!/bin/bash
# Runs as ptbk-relay-cert.service (a dynamic user): issues the relay certificate once, then renews it when lego's
# default says so (a third of its lifetime left, or the CA's renewal info), which follows shorter CA lifetimes. lego
# follows the _acme-challenge CNAME into the challenge zone (production), or without one writes the record into the
# relay's own zone (staging, one domain).
set -euo pipefail

: "${STATE_DIRECTORY:?}" "${PTBK_RELAY_HOSTNAME:?}" "${PTBK_ACME_EMAIL:?}" "${PTBK_ACME_SERVER:?}"

# The timer already spreads the runs (RandomizedDelaySec), so lego's own random sleep would only delay it. Only the
# authoritative servers are awaited, as the CA queries them: unbound caches the NXDOMAIN of lego's first look at the
# challenge name for the zone's negative TTL, so waiting for it to see the record timed out.
exec lego --log.format=text run \
    --accept-tos \
    --path="$STATE_DIRECTORY" \
    --server="$PTBK_ACME_SERVER" \
    --email="$PTBK_ACME_EMAIL" \
    --domains="$PTBK_RELAY_HOSTNAME" \
    --key-type=EC256 \
    --dns=cloudflare \
    --dns.resolvers=127.0.0.1:53 \
    --dns.propagation.disable-rns \
    --no-random-sleep
